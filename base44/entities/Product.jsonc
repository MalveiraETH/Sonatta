{
  "name": "Product",
  "type": "object",
  "properties": {
    "stock_type": {
      "type": "string",
      "enum": [
        "serializado",
        "nao_serializado"
      ],
      "description": "Tipo de controle de estoque"
    },
    "name": {
      "type": "string",
      "description": "Nome do produto"
    },
    "reference": {
      "type": "string",
      "description": "C\u00f3digo de refer\u00eancia (vinculado a Produtos de Refer\u00eancia)"
    },
    "category": {
      "type": "string",
      "enum": [
        "aparelho_auditivo",
        "bateria",
        "carregador",
        "cerustop",
        "desumidificador",
        "gancho",
        "gaveta",
        "microfone",
        "molde",
        "oliva",
        "outros",
        "receptor",
        "tubo_molde"
      ],
      "description": "Categoria do produto"
    },
    "brand": {
      "type": "string",
      "description": "Marca"
    },
    "model": {
      "type": "string",
      "description": "Modelo"
    },
    "serial_number": {
      "type": "string",
      "description": "N\u00famero de s\u00e9rie (somente para produtos serializados)"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Quantidade (para n\u00e3o serializados)"
    },
    "product_cost": {
      "type": "number",
      "default": 0,
      "description": "Custo do produto (sem impostos)"
    },
    "icms": {
      "type": "number",
      "default": 0,
      "description": "Valor do ICMS em R$"
    },
    "ipi": {
      "type": "number",
      "default": 0,
      "description": "Valor do IPI em R$"
    },
    "cost_price": {
      "type": "number",
      "description": "Custo Total (R$)"
    },
    "sale_price": {
      "type": "number",
      "description": "Valor de venda"
    },
    "markup_category": {
      "type": "string",
      "enum": [
        "90",
        "70",
        "50",
        "30",
        "10",
        "5"
      ],
      "description": "Categoria de markup para precifica\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "disponivel",
        "reservado",
        "vendido",
        "baixo_estoque",
        "indisponivel",
        "descartado"
      ],
      "default": "disponivel",
      "description": "Status do produto"
    },
    "min_stock": {
      "type": "number",
      "default": 5,
      "description": "Estoque m\u00ednimo (para alertas)"
    },
    "nota_fiscal_entrada": {
      "type": "string",
      "description": "Nota fiscal de entrada"
    },
    "entry_date": {
      "type": "string",
      "format": "date",
      "description": "Data de entrada no estoque"
    },
    "warranty_years": {
      "type": "number",
      "enum": [
        1,
        2,
        3,
        4
      ],
      "description": "Anos de garantia (para serializados)"
    },
    "power_type": {
      "type": "string",
      "enum": [
        "pilha",
        "bateria_recarregavel"
      ],
      "description": "Tipo de funcionamento (para aparelhos)"
    },
    "is_trial": {
      "type": "boolean",
      "default": false,
      "description": "Produto destinado apenas a testes/trial (n\u00e3o ser\u00e1 vendido)"
    },
    "include_fixed_cost": {
      "type": "boolean",
      "default": true,
      "description": "Se o custo operacional (fixo mensal) est\u00e1 inclu\u00eddo no custo total"
    },
    "discard_reason": {
      "type": "string",
      "enum": [
        "quebra",
        "descarte",
        "fim_de_vida"
      ],
      "description": "Motivo da baixa do aparelho"
    },
    "discard_date": {
      "type": "string",
      "format": "date",
      "description": "Data da baixa/descarte"
    },
    "discard_protocol": {
      "type": "string",
      "description": "N\u00ba de NF ou protocolo de descarte"
    },
    "discard_notes": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o sobre a baixa"
    },
    "discarded_by_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que registrou a baixa"
    },
    "discarded_by_name": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que registrou a baixa"
    },
    "client_id": {
      "type": "string",
      "description": "ID do cliente vinculado (associa\u00e7\u00e3o manual de produto vendido sem venda)"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente vinculado (associa\u00e7\u00e3o manual)"
    },
    "association_date": {
      "type": "string",
      "format": "date",
      "description": "Data da associa\u00e7\u00e3o manual do produto ao cliente"
    },
    "substitution_date": {
      "type": "string",
      "format": "date",
      "description": "Data da substitui\u00e7\u00e3o (troca de aparelho com defeito)"
    },
    "substitution_problem": {
      "type": "string",
      "description": "Defeito relatado no aparelho substitu\u00eddo"
    },
    "substitution_notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es da substitui\u00e7\u00e3o"
    },
    "substitution_stage": {
      "type": "string",
      "enum": [
        "aguardando_conserto",
        "conserto_concluido"
      ],
      "description": "Etapa do conserto do aparelho substitu\u00eddo"
    },
    "substitution_client_id": {
      "type": "string",
      "description": "ID do cliente atendido na substitui\u00e7\u00e3o"
    },
    "substitution_client_name": {
      "type": "string",
      "description": "Nome do cliente atendido na substitui\u00e7\u00e3o"
    },
    "substituted_by_id": {
      "type": "string",
      "description": "ID do aparelho que substituiu este"
    },
    "substituted_by_serial": {
      "type": "string",
      "description": "N\u00famero de s\u00e9rie do aparelho que substituiu este"
    },
    "replaced_product_id": {
      "type": "string",
      "description": "ID do aparelho com defeito que este aparelho substituiu"
    },
    "replaced_serial": {
      "type": "string",
      "description": "N\u00famero de s\u00e9rie do aparelho com defeito que este substituiu"
    },
    "returned_to_stock_date": {
      "type": "string",
      "format": "date",
      "description": "Data de retorno ao estoque ap\u00f3s o conserto ou devolu\u00e7\u00e3o da loca\u00e7\u00e3o"
    },
    "rental_id": {
      "type": "string",
      "description": "ID da loca\u00e7\u00e3o ativa deste aparelho"
    },
    "rental_number": {
      "type": "string",
      "description": "N\u00famero da loca\u00e7\u00e3o ativa deste aparelho"
    },
    "rental_client_name": {
      "type": "string",
      "description": "Nome do cliente que est\u00e1 com o aparelho locado"
    },
    "rental_start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio da loca\u00e7\u00e3o ativa"
    }
  },
  "required": [
    "name",
    "category",
    "sale_price",
    "stock_type"
  ],
  "rls": {
    "read": true,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}