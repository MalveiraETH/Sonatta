{
  "name": "Rental",
  "type": "object",
  "properties": {
    "rental_number": {
      "type": "string",
      "description": "N\u00famero da loca\u00e7\u00e3o"
    },
    "client_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "client_cpf": {
      "type": "string",
      "description": "CPF do cliente"
    },
    "client_phone": {
      "type": "string",
      "description": "Telefone do cliente"
    },
    "product_id": {
      "type": "string",
      "description": "ID do aparelho locado"
    },
    "product_name": {
      "type": "string",
      "description": "Nome do aparelho locado"
    },
    "serial_number": {
      "type": "string",
      "description": "N\u00famero de s\u00e9rie do aparelho locado"
    },
    "product_reference": {
      "type": "string",
      "description": "Refer\u00eancia do aparelho"
    },
    "service_id": {
      "type": "string",
      "description": "ID do servi\u00e7o vinculado (Loca\u00e7\u00e3o de AASI)"
    },
    "service_name": {
      "type": "string",
      "description": "Nome do servi\u00e7o vinculado"
    },
    "term_type": {
      "type": "string",
      "enum": [
        "determinado",
        "indeterminado"
      ],
      "default": "determinado",
      "description": "Prazo da loca\u00e7\u00e3o (definido ou indeterminado)"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio da loca\u00e7\u00e3o"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de t\u00e9rmino prevista (quando o prazo \u00e9 definido)"
    },
    "monthly_amount": {
      "type": "number",
      "description": "Valor mensal da loca\u00e7\u00e3o (R$)"
    },
    "due_day": {
      "type": "number",
      "default": 10,
      "description": "Dia de vencimento das cobran\u00e7as mensais (1 a 31)"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "dinheiro",
        "pix",
        "cartao_credito",
        "cartao_debito",
        "boleto",
        "transferencia"
      ],
      "default": "pix",
      "description": "Forma de pagamento prevista"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativa",
        "encerrada",
        "cancelada"
      ],
      "default": "ativa",
      "description": "Status da loca\u00e7\u00e3o"
    },
    "termination_date": {
      "type": "string",
      "format": "date",
      "description": "Data de encerramento da loca\u00e7\u00e3o"
    },
    "termination_reason": {
      "type": "string",
      "description": "Motivo do encerramento"
    },
    "device_returned": {
      "type": "boolean",
      "default": false,
      "description": "Se o aparelho foi devolvido ao estoque"
    },
    "device_return_condition": {
      "type": "string",
      "description": "Estado do aparelho na devolu\u00e7\u00e3o"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "created_by_name": {
      "type": "string",
      "description": "Usu\u00e1rio que registrou a loca\u00e7\u00e3o"
    }
  },
  "required": [
    "client_id",
    "product_id",
    "start_date",
    "monthly_amount",
    "due_day"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}