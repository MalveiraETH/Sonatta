{
  "name": "WarrantyCertificate",
  "type": "object",
  "properties": {
    "certificate_number": {
      "type": "string",
      "description": "N\u00famero do certificado (mesmo n\u00famero da venda, com prefixo CRT-)"
    },
    "sale_id": {
      "type": "string",
      "description": "ID da venda de origem"
    },
    "sale_number": {
      "type": "string",
      "description": "N\u00famero da venda de origem"
    },
    "sale_date": {
      "type": "string",
      "format": "date",
      "description": "Data da compra"
    },
    "client_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "client_cpf": {
      "type": "string",
      "description": "CPF do cliente"
    },
    "warranty_start": {
      "type": "string",
      "format": "date",
      "description": "In\u00edcio da garantia (data da compra)"
    },
    "warranty_end": {
      "type": "string",
      "format": "date",
      "description": "Fim da garantia mais longa entre os aparelhos"
    },
    "review_1_date": {
      "type": "string",
      "format": "date",
      "description": "Data da revis\u00e3o 1 (3 meses ap\u00f3s a compra)"
    },
    "review_2_date": {
      "type": "string",
      "format": "date",
      "description": "Data da revis\u00e3o 2 (9 meses ap\u00f3s a compra)"
    },
    "items": {
      "type": "array",
      "description": "Aparelhos cobertos pelo certificado, com garantia individual",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "description": "ID do produto no estoque"
          },
          "product_name": {
            "type": "string",
            "description": "Nome do aparelho"
          },
          "brand": {
            "type": "string",
            "description": "Marca"
          },
          "model": {
            "type": "string",
            "description": "Modelo"
          },
          "serial_number": {
            "type": "string",
            "description": "N\u00famero de s\u00e9rie"
          },
          "warranty_years": {
            "type": "number",
            "description": "Anos de garantia do aparelho"
          },
          "warranty_start": {
            "type": "string",
            "format": "date",
            "description": "In\u00edcio da garantia do aparelho"
          },
          "warranty_end": {
            "type": "string",
            "format": "date",
            "description": "Fim da garantia do aparelho"
          }
        }
      }
    },
    "generated_at": {
      "type": "string",
      "description": "Data e hora da gera\u00e7\u00e3o do certificado"
    }
  },
  "required": [
    "certificate_number",
    "sale_id",
    "sale_number",
    "sale_date"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}