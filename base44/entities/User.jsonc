{
  "name": "User",
  "type": "object",
  "properties": {
    "whatsapp_quote_template": {
      "type": "string",
      "description": "Template personalizado para mensagens de or\u00e7amento via WhatsApp"
    },
    "contact_phone": {
      "type": "string",
      "description": "Telefone de contato da empresa"
    },
    "access_status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ],
      "enumColors": [
        "green",
        "red"
      ],
      "default": "ativo",
      "description": "Situa\u00e7\u00e3o do acesso do usu\u00e1rio ao sistema"
    }
  },
  "required": [
    "whatsapp_quote_template",
    "contact_phone"
  ]
}