{
  "name": "Auto-pagar venda quando parcelas quitadas",
  "description": "",
  "trigger": {
    "condition": "${ (.trigger.data.payment_status == \"pago\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Installment"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_pagar_venda_quando_parcelas_quitadas",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkInstallmentsPaid",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "checkInstallmentsPaid"
  }
}